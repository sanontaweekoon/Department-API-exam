{
  "uid": "spring-logs",
  "title": "Spring Boot \u2014 logs",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "spring-boot"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{environment=~\"$environment\"}, application)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{environment=~\"$environment\",application=~\"$application\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "type": "custom",
        "query": "TRACE,DEBUG,INFO,WARN,ERROR",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Text search (literal)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by severity",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, level) (count_over_time({application=~\"$application\",environment=~\"$environment\",instance=~\"$instance\",level=~\"$severity\"} |= ${search:doublequote} [$__interval]))",
          "legendFormat": "{{application}} / {{level}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Application logs \u2014 expand a row for JSON fields and full stack_trace",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{application=~\"$application\",environment=~\"$environment\",instance=~\"$instance\",level=~\"$severity\"} |= ${search:doublequote} | json | line_format \"{{.level}} {{.logger_name}} [{{.thread_name}}] {{.message}}{{if .stack_trace}}\\n{{.stack_trace}}{{end}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "links": [
    {
      "title": "Application metrics",
      "type": "link",
      "url": "/d/spring-metrics",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Application logs",
      "type": "link",
      "url": "/d/spring-logs",
      "includeVars": true,
      "keepTime": true
    }
  ]
}