      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, instance, status) (rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{application}} / {{instance}} / {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
